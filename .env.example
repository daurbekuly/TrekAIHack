# --- Core ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/inventory
APP_NAME=Inventory Forecasting API
DEBUG=false
STORE_TIMEZONE=Asia/Almaty

# --- Admin API (issues Telegram link codes). Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# --- OpenAI (optional: without a key the bot sends a template message) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
REPORT_LANGUAGE=Russian

# --- Telegram bot (from @BotFather). Without a token the bot is disabled. ---
TELEGRAM_BOT_TOKEN=
# Production: public HTTPS URL of POST /telegram/webhook. Leave empty for long polling (local dev).
TELEGRAM_WEBHOOK_URL=
# Required in webhook mode. Allowed chars: A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=

# --- Morning reports (STORE_TIMEZONE). Enable on exactly ONE process/replica. ---
SCHEDULER_ENABLED=true
MORNING_REPORT_HOUR=8
MORNING_REPORT_MINUTE=0
